{
  "name": "eco-sled",
  "version": "1.0.0",
  "private": true,
  "description": "Эко-След — гид по осознанному потреблению. MVP: онбординг, Eco Score, след, советы, челленджи и очки.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --experimental-strip-types apps/api/src/main.ts",
    "dev": "node --watch --experimental-strip-types apps/api/src/main.ts",
    "test": "node --experimental-strip-types --test packages/calculations/src/calculations.test.ts apps/api/src/api.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
